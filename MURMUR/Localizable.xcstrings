    "Audio services were reset. Open the recording again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodienste wurden zurückgesetzt. Öffnen Sie die Aufnahme erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de audio se han reiniciado. Vuelve a abrir la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services audio ont été réinitialisés. Rouvrez l'enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi audio sono stati reimpostati. Riapri la registrazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços de áudio foram reiniciados. Abra a gravação novamente."
          }
        }
