    "Automatic follows your device's languages. Transcription runs on this device and your audio is never sent anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ folgt den Sprachen Ihres Geräts. Die Transkription läuft auf diesem Gerät, Ihr Audio wird nie irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático sigue los idiomas de tu dispositivo. La transcripción se hace en este dispositivo y tu audio nunca se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique suit les langues de votre appareil. La transcription s'effectue sur cet appareil et votre audio n'est jamais envoyé ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico segue le lingue del dispositivo. La trascrizione avviene su questo dispositivo e l'audio non viene mai inviato altrove."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático segue os idiomas do seu dispositivo. A transcrição é feita neste dispositivo e o seu áudio nunca é enviado para lugar nenhum."
          }
        }
      }
    },
